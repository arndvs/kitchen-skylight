{
  "name": "kitchen-skylight",
  "version": "0.8.0",
  "description": "Kitchen Skylight — family calendar, recipes, and home automation hub (fork of OpenSkyLight)",
  "main": "./out/main/index.js",
  "author": "arndvs",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:windowed": "electron-vite dev -- --windowed",
    "dev:companion": "vite --config companion.vite.config.ts",
    "build": "electron-vite build && npm run build:companion",
    "build:companion": "vite build --config companion.vite.config.ts",
    "preview": "electron-vite preview",
    "import:recipes": "electron scripts/import-recipes.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "@googleapis/calendar": "^15.0.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.38.4",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.8.0",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^10.7.0",
    "ical.js": "^2.2.1",
    "luxon": "^3.5.0",
    "mpegts.js": "^1.8.0",
    "rrule": "^2.8.1",
    "ws": "^8.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/nunito": "^5.1.0",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-query": "^5.66.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "playwright-core": "^1.60.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-simple-keyboard": "^3.8.27",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "zustand": "^5.0.3"
  },
  "allowScripts": {
    "electron@34.5.8": true,
    "better-sqlite3@12.10.0": true,
    "esbuild@0.25.12": true,
    "ffmpeg-static@5.3.0": true
  }
}
